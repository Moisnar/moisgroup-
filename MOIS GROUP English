<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MOIS Group — فرصة عمل | الوجه الإعلامي</title>
<style>
@font-face{font-family:'Montserrat';font-weight:400;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Montserrat';font-weight:500;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Montserrat';font-weight:700;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Tajawal';font-weight:400;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Tajawal';font-weight:500;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}
@font-face{font-family:'Tajawal';font-weight:700;font-style:normal;font-display:swap;src:url(data:font/woff;base64,) format('woff')}

:root{--blue:#1637ff;--blue-d:#0f28c7;--bg:#fff;--ink:#0b0d14;--mute:#5b6070;--line:#dfe2ee;--chip:#f3f5ff;--err:#d92d20;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b0d14;--ink:#f4f5fb;--mute:#a3a8ba;--line:#262a3b;--chip:#151932;--err:#ff6b5e}}
*{box-sizing:border-box;margin:0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{font-family:'Montserrat','Tajawal',sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
.hero{background:var(--blue);color:#fff;padding:20px 24px 44px;background-image:radial-gradient(circle at 85% 20%,rgba(255,255,255,.18),transparent 55%)}
.bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:44px}
.logo{font-weight:700;font-size:22px;letter-spacing:.04em;direction:ltr}
.logo small{display:block;font-size:9px;letter-spacing:.5em;font-weight:500;opacity:.85}
.lang{border:1.5px solid rgba(255,255,255,.45);background:transparent;color:#fff;border-radius:99px;padding:8px 18px;font:500 14px inherit;font-family:inherit;cursor:pointer}
.tag{display:inline-block;border:1.5px solid rgba(255,255,255,.45);border-radius:99px;padding:4px 14px;font-size:13px;font-weight:500;margin-bottom:16px}
h1{font-size:clamp(34px,9vw,52px);line-height:1.2;font-weight:700;margin-bottom:14px}
.sub{font-size:17px;font-weight:400;opacity:.9;max-width:520px}
main{max-width:640px;margin:0 auto;padding:36px 24px 56px}
.field{margin-bottom:30px;border:0;padding:0;min-width:0}
legend,.lbl{font-size:18px;font-weight:700;margin-bottom:12px;display:block;padding:0}
.opt{font-weight:400;color:var(--mute);font-size:14px;margin-inline-start:6px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip input{position:absolute;opacity:0;pointer-events:none}
.chip span{display:inline-block;padding:12px 22px;border:1.5px solid var(--line);background:var(--chip);border-radius:99px;font-size:16px;font-weight:500;cursor:pointer;transition:.15s;user-select:none}
.chip input:checked+span{background:var(--blue);border-color:var(--blue);color:#fff}
.chip input:focus-visible+span{outline:3px solid var(--blue);outline-offset:2px}
textarea{width:100%;min-height:120px;border:1.5px solid var(--line);background:var(--chip);color:var(--ink);border-radius:22px;padding:16px 20px;font:400 16px/1.6 inherit;font-family:inherit;resize:vertical}
textarea:focus{outline:3px solid var(--blue);outline-offset:1px}
.hint{font-size:14px;color:var(--mute);margin-top:8px}
.err{color:var(--err);font-size:14px;font-weight:500;margin-top:8px;display:none}
.field.bad .err{display:block}
.field.bad .chip span{border-color:var(--err)}
.send{width:100%;border:0;background:var(--blue);color:#fff;border-radius:99px;padding:18px;font:700 18px inherit;font-family:inherit;cursor:pointer;display:flex;gap:10px;justify-content:center;align-items:center}
.send:active{background:var(--blue-d)}
.send svg{width:22px;height:22px;fill:currentColor}
.note{text-align:center;font-size:14px;color:var(--mute);margin-top:14px}
</style>
</head>
<body>
<header class="hero">
  <div class="bar">
    <div class="logo">MOIS<small>GROUP</small></div>
    <button class="lang" id="lang" type="button">English</button>
  </div>
  <span class="tag" data-t="tag"></span>
  <h1 data-t="title"></h1>
  <p class="sub" data-t="sub"></p>
</header>

<main>
<form id="f" novalidate>
  <fieldset class="field" id="g-gender">
    <legend data-t="gender"></legend>
    <div class="chips" id="gender"></div>
    <p class="err" data-t="req"></p>
  </fieldset>

  <fieldset class="field" id="g-age">
    <legend data-t="age"></legend>
    <div class="chips" id="age"></div>
    <p class="err" data-t="req"></p>
  </fieldset>

  <div class="field">
    <label class="lbl" for="desc"><span data-t="desc"></span><span class="opt" data-t="optional"></span></label>
    <textarea id="desc" data-p="descPh"></textarea>
  </div>

  <button class="send" type="submit">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.8-.1 1.4z"/></svg>
    <span data-t="send"></span>
  </button>
  <p class="note" data-t="note"></p>
</form>
</main>

<script>
var PHONE="963994085889";
var L={
ar:{dir:"rtl",toggle:"English",tag:"فرصة عمل",title:"الوجه الإعلامي",sub:"نبحث عن وجه جديد يمثّل MOIS Group أمام الكاميرا. عبّئ البيانات وسنكمل المحادثة معك على واتساب.",
gender:"الجنس",age:"العمر",desc:"وصف عنك",optional:"(اختياري)",descPh:"أخبرنا عن نفسك أو عن خبرتك إن أحببت…",
req:"يرجى الاختيار",send:"تابع عبر واتساب",note:"سيُفتح واتساب برسالة جاهزة، فقط اضغط إرسال.",
genders:["ذكر","أنثى"],ages:["16 – 20","21 – 25","26 – 30","31 – 40","41+"],

msgHead:"مرحباً MOIS Group، أرغب بالتقديم على فرصة الوجه الإعلامي.",mG:"الجنس",mA:"العمر",mD:"وصف",sep:"، "},
en:{dir:"ltr",toggle:"العربية",tag:"Job opportunity",title:"On-camera media face",sub:"We’re looking for a new face to represent MOIS Group on camera. Fill in your details and we’ll continue the conversation on WhatsApp.",
gender:"Gender",age:"Age",desc:"About you",optional:"(optional)",descPh:"Tell us about yourself or your experience, if you like…",
req:"Please choose an option",send:"Continue on WhatsApp",note:"WhatsApp will open with a ready message. Just press send.",
genders:["Male","Female"],ages:["16 – 20","21 – 25","26 – 30","31 – 40","41+"],

msgHead:"Hello MOIS Group, I’d like to apply for the on-camera media face opportunity.",mG:"Gender",mA:"Age",mD:"About me",sep:", "}
};
var lang="ar",$=function(s){return document.querySelector(s)};
function chips(id,name,type,items,keep){
  var box=$("#"+id),old=[].map.call(box.querySelectorAll("input"),function(i){return i.checked});
  box.innerHTML="";
  items.forEach(function(t,i){
    var l=document.createElement("label");l.className="chip";
    l.innerHTML='<input type="'+type+'" name="'+name+'"><span></span>';
    l.querySelector("span").textContent=t;
    l.querySelector("input").checked=!!old[i];
    l.querySelector("input").onchange=function(){l.closest(".field").classList.remove("bad")};
    box.appendChild(l);
  });
}
function render(){
  var d=L[lang];
  document.documentElement.lang=lang;document.documentElement.dir=d.dir;
  document.querySelectorAll("[data-t]").forEach(function(e){e.textContent=d[e.dataset.t]});
  document.querySelectorAll("[data-p]").forEach(function(e){e.placeholder=d[e.dataset.p]});
  $("#lang").textContent=d.toggle;
  chips("gender","gender","radio",d.genders);
  chips("age","age","radio",d.ages);
}
function picked(id){
  var d=L[lang],out=[];
  document.querySelectorAll("#"+id+" label").forEach(function(l,i){
    if(l.querySelector("input").checked)out.push(l.querySelector("span").textContent);
  });
  return out;
}
$("#lang").onclick=function(){lang=lang==="ar"?"en":"ar";render()};
$("#f").onsubmit=function(e){
  e.preventDefault();
  var d=L[lang],g=picked("gender"),a=picked("age"),ok=true;
  [["g-gender",g],["g-age",a]].forEach(function(p){
    var bad=!p[1].length;$("#"+p[0]).classList.toggle("bad",bad);
    if(bad&&ok){ok=false;$("#"+p[0]).scrollIntoView({behavior:"smooth",block:"center"})}
  });
  if(!ok)return;
  var m=d.msgHead+"\n\n"+d.mG+": "+g[0]+"\n"+d.mA+": "+a[0];
  var t=$("#desc").value.trim();
  if(t)m+="\n"+d.mD+": "+t;
  window.location.href="https://wa.me/"+PHONE+"?text="+encodeURIComponent(m);
};
render();
</script>
</body>
</html>
